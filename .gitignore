build/

# The cartridge IS committed -- see README's Legal section for who owns it and
# how to ask for its removal. Everything else that lands in roms/ is not: the
# directory is ignored and the one dump the build depends on is un-ignored by
# name, so an alternate or bad dump cannot be swept in by `git add -A`.
roms/*
!roms/Dune-The-Battle-for-Arrakis_Genesis_EN/
roms/Dune-The-Battle-for-Arrakis_Genesis_EN/*
!roms/Dune-The-Battle-for-Arrakis_Genesis_EN/Dune - The Battle for Arrakis (E).bin

*.o
*.bin.disasm
__pycache__/
src/gen/*.c
ref/

# Emulator output. None of this is ours to publish: framebuffers, RAM dumps and
# audio captures are all derived from the cartridge, and every one of them is
# regenerable from a make target.
*.ppm
*.png
*.wav
*.ram
*.state
*.trace
*.bundle

# Files created when a shell flag lands in the filename position -- how a 210 KB
# framebuffer and an 8 KB Z80 RAM dump of the sound driver reached a commit.
/1
/--*

# a player's local settings; db4a.conf.example is the tracked template
db4a.conf
