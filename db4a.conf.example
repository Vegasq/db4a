# db4a settings
# =============
#
# Copy this file to `db4a.conf` next to the binary, uncomment what you want,
# and restart the game. Nothing here needs a shell or a rebuild.
#
#   DB4A_CONF=/path/to/other.conf     reads somewhere else instead
#
# Format
# ------
#   key = value        one setting per line
#   # comment          anything after a # is ignored
#
# Keys are the environment-variable names without the DB4A_ prefix, so
# `gain = 8` in this file is the same as running with DB4A_GAIN=8.
#
# Anything that just needs to be "on" takes 1. Setting it to 0 is NOT the same
# as leaving it out for every option -- where 0 means something specific, it
# says so below.
#
# The environment always wins
# ---------------------------
# If a variable is set in the environment it beats this file, so you can try a
# value for a single run without editing anything:
#
#   DB4A_GAIN=16 make play
#
# That rule exists for a practical reason: every test in this project drives
# the binary through environment variables, and a line in your personal config
# must not be able to change what a test does.
#
# What is deliberately NOT here
# -----------------------------
# Only settings describing how you want to PLAY live in this file. The
# diagnostics and test controls -- DB4A_REPLAY, DB4A_SHOTS, DB4A_WATCH,
# DB4A_NATIVE, DB4A_MOUSE_TARGET, the whole DB4A_LOG_* family -- stay
# environment-only on purpose. Each exists to make one run behave unusually,
# and a file that persists across every future run is the wrong place for
# that: you end up debugging your own configuration instead of the game.
#
# On startup the game prints what it actually resolved, so you can see whether
# this file was picked up:
#
#   config: 3 setting(s) from db4a.conf
#   settings: gain=8 mute=no state=build/state.db4a keys=(default)


# =========================================================================
# Audio
# =========================================================================

# gain = 4
#
#   Output volume, as a plain multiplier applied to the mixed sample before
#   it is clipped. Range 1-64, default 4.
#
#   The cartridge drives everything through the YM2612 and mixes fairly
#   quietly, so 4 is chosen to leave headroom rather than to be loud. If the
#   game is too quiet against everything else on your desktop, raise it.
#   Values high enough to clip will distort rather than get louder -- if it
#   starts sounding harsh, come back down.

# mute = 1
#
#   Open no audio device at all. Not a volume of zero: the game still runs
#   its sound driver and the emulated chips still work, but nothing is sent
#   to the system.
#
#   Useful when another program has the sound device, when you are running
#   over a remote session, or when you simply want silence without turning
#   your whole machine down.


# =========================================================================
# Input
# =========================================================================

# keys = a=q,b=w,c=e
#
#   Remap the three face buttons. The defaults are:
#
#     arrows       D-pad
#     Q W E        A B C        (Z X C, Space, Alt and Shift also work)
#     Enter        Start        (Tab also works)
#     Esc          quit
#     F5 / F9      save / load state
#     P            pause
#     ` or F       fast-forward while held
#     F11          toggle fullscreen
#
#   Naming a button in this setting DROPS its defaults, so `a=q` means A is
#   reachable only from Q -- Z, Space and the rest stop working for A. Buttons
#   you do not name keep everything they had.
#
#   Gamepads are picked up automatically and are not affected by this.


# =========================================================================
# Save states
# =========================================================================

# state = build/state.db4a
#
#   Where F5 writes and F9 reads. Default build/state.db4a.
#
#   Two things worth knowing. `build/` is deleted by `make clean`, so a state
#   you want to keep belongs somewhere else -- data/states/ is gitignored and
#   is the intended home. And a state records the whole machine, so a build
#   that changes the CPU or sound-chip layout will refuse to load an older
#   file rather than load it corrupt.
#
#   These files contain cartridge memory, so they are game data: keep them out
#   of the repository, as .gitignore already arranges.


# =========================================================================
# Display                                            (remaster branch only)
# =========================================================================

# fullscreen = 1
#
#   Start fullscreen instead of in a window. F11 toggles it at runtime either
#   way, so this only decides how the game comes up.

# integer = 1
#
#   Scale the 320x224 picture by whole numbers only. Sharper, because every
#   source pixel becomes the same number of screen pixels, at the cost of
#   black borders where the window does not divide evenly. Leave it out to
#   fill the window and accept slightly uneven pixels.


# wide = 400
#
#   EXPERIMENTAL. Widens the view from the cartridge's 320 pixels to the width
#   given here, between 320 and 1024. Left out entirely, the game runs at 320
#   and nothing below applies.
#
#   Why 1024 and not more. That is the size of the game's own map. The
#   cartridge tells us so itself: the camera limits it writes leave a world
#   exactly 1024 pixels square in both missions measured, so a 1024-wide view
#   shows the whole map at once and holds the camera still. Ask for more and
#   the extra can only be empty space.
#
#   What it does. During GAMEPLAY the whole picture is shifted right by the
#   extra width, which keeps the HUD flush against the right edge with its
#   backdrop still underneath it, and the new space opens on the left as more
#   map. Everywhere else -- menus, the mentat, cutscenes -- there is nothing
#   to anchor, so the 320 composition is centred and the surplus is left as
#   black bars rather than stretched.
#
#   Where the extra picture comes from. The game only ever writes tiles for
#   the 320 pixels it believes are visible, so the margin is drawn from the
#   game's own MAP DATA instead -- the same grid the cartridge expands into
#   tiles, read straight out of work RAM. That has no dependence on which way
#   you last scrolled and no leftovers to show. It cannot invent map, so
#   ground you have never explored stays dark exactly as the cartridge would
#   leave it.
#
#   Why it is still marked experimental: it is a departure from the cartridge,
#   it has not had the play-testing the 320 path has, and the wider the view
#   the more of the screen is fog of war rather than scenery.
#
#   The game's own 320 pixels are unaffected either way: with widescreen off,
#   output is byte-identical to the faithful build.
#
#   docs/widescreen.md records the measurements, and the three possible ways
#   forward.

# tall = 240
#
#   The same idea as `wide`, downwards: the number of scanlines to show,
#   between 224 and 1024. Left out, the game runs at the 224 lines a Mega Drive
#   shows in its usual mode. 1024 is the map's own height, for the same reason
#   1024 is the limit on `wide`.
#
#   Anything is allowed between those, so 640x480 and 800x600 work as well as
#   the old 400x240. `make check-res` proves the cartridge's own 320x224 comes
#   out byte-identical inside all nine sizes it tries, up to 1024x1024.
#
#   The extra lines appear BELOW the cartridge's own picture, and are filled
#   the same way the widened strip is -- real map, with the units standing in
#   it. Whatever the cartridge itself drew is untouched at any size, which
#   `make check-res` verifies at six of them.
#
#   The same caveat as `wide` applies: the cartridge only maintains what it
#   believes is visible, so the margins depend on ground it has drawn recently.



# splash = 0
#
#   How long the start-up notice is held, in frames. Default 200, about four
#   seconds at 49.7 Hz. Any key, mouse button or pad button dismisses it early;
#   0 skips it entirely.
#
#   The notice says this is an unofficial native port, not a Sega release and
#   not connected to the rights holders, names the game's copyright holders,
#   and shows where the source lives. Please leave it on in anything you pass
#   to someone else -- it is the only thing telling them what they are running.


# =========================================================================
# Mouse control                                      (remaster branch only)
# =========================================================================

# mouse = 1
#
#   Point at the map and the game's cursor goes there. Left button is A,
#   right is B, middle is C. Off by default; with it off the keyboard and pad
#   behave exactly as the cartridge intends.
#
#   Worth knowing why this is not just "steering": the cartridge moves its
#   own cursor at most three pixels a frame, so crossing the screen takes
#   over two seconds and no amount of nudging can make it keep up with a
#   pointer. With this on, the cursor position is written directly, so it is
#   under the pointer on the same frame.
#
#   While it is on, the system pointer is hidden wherever the game draws a
#   cursor of its own, so you never see two at once.

# syscursor = 1
#
#   Keep the system pointer visible over the game window anyway. Mostly
#   useful for seeing how far the game's cursor is lagging your real one.

# menu_mouse = 0
#
#   Turn OFF pointer selection in the game's menus while leaving it on for
#   the map. Affects the Construction Yard's build console, the Starport,
#   house selection and the mentat's yes/no -- pointing at an icon or a
#   button selects it, and left click activates it.
#
#   Set this to 0 if you would rather drive those screens with the d-pad.

# mouse_edge = 24
#
#   How many pixels in from each screen edge count as "scroll the map"
#   instead of "move the cursor". Default 24.
#
#   For contrast, the cartridge's own rule is that the map scrolls whenever
#   the cursor leaves a box in the middle of the screen roughly a quarter of
#   its width -- fine for a d-pad, unusable with a mouse, because the map
#   lurches the moment you point away from centre. This setting replaces that
#   box with a band at the edges.
#
#   Larger values scroll from further in. Keep it comfortably above
#   mouse_clamp below, or there is no room left to scroll in.

# mouse_clamp = 4
#
#   How close to the screen edge the cursor itself may get, in pixels.
#   Default 4; the cartridge's own value is 24, which makes the outermost
#   strip of the map unreachable with a pointer.
#
#   This must stay well inside mouse_edge. Scroll speed is worked out from
#   how far INTO the band the cursor has travelled, so if the two meet there
#   is no depth to measure and the map will not scroll at all.

# scroll_max = 6
#
#   Top scrolling speed in pixels per frame, reached when you push the
#   pointer right into the corner. Default 6; the cartridge's own limit is 3.
#   Speed ramps with how far into the band you are, so easing in still
#   creeps.

# place_scroll = 1
#
#   Put back the view re-centring that happens when a building is ready and
#   the cursor becomes its outline.
#
#   The cartridge scrolls the map to bring that outline towards the middle of
#   the screen, which helps with a d-pad and is disorienting with a mouse:
#   the pointer is already where you are looking and the map moves out from
#   under it. With mouse control on, that scrolling is suppressed by default;
#   set this to 1 if you prefer the original behaviour.
